# Copy to .env and fill in. .env is ignored by git; never commit a key.
# The CLI reads .env from the folder it runs in. A value in .env wins over the same variable in the shell.

# Model for the policy grounding.
#   offline        a deterministic stand-in; no network, no key, no cost
#   <model name>   an OpenAI model with tool calling
AP_LLM_MODEL=offline

# OpenAI API key. Needed only when AP_LLM_MODEL names an OpenAI model.
OPENAI_API_KEY=
